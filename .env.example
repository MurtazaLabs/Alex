# Forex AI Agent (Alex) — Environment Configuration
# Copy this file to .env and fill in your values.
# NOTE: with no DATABASE_URL and no .env present, Alex auto-falls back to
#       sqlite+aiosqlite:///alex_local.db so the CLI works out of the box.

# Database (production: Postgres; local dev: leave unset for SQLite)
# DATABASE_URL=postgresql+asyncpg://forex_user:forex_password@localhost:5432/forex_ai

# Redis (optional — event bus falls back to in-memory)
# REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development

# Security
SECRET_KEY=your-super-secret-key-change-in-production

# MetaTrader 5 Configuration (primary feed when configured)
MT5_LOGIN=123456
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Data feeds (failover chain; first healthy provider wins)
DATA_FEED_CHAIN=mt5,yahoo,twelvedata,mock
TWELVEDATA_API_KEY=
FEED_HEALTH_COOLDOWN_S=300

# LLM (remote chain: OpenRouter -> UnoRouter fallback; narration prefers local Ollama when configured)
LLM_ENABLED=true
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ALEX_LLM_NARRATIVE_MODEL=nvidia/nemotron-3.5-lightning:free
ALEX_LLM_REASONING_MODEL=google/gemma-4-31b-it

# UnoRouter (https://unorouter.com) - OpenAI-compatible fallback gateway.
# Used when OpenRouter fails or has no key. A tier routes through it
# ONLY when its model below is set; free models are suffixed :free.
UNOROUTER_API_KEY=
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
ALEX_LLM_UNOROUTER_NARRATIVE_MODEL=
ALEX_LLM_UNOROUTER_REASONING_MODEL=
# Remote provider order (comma-separated). Default: openrouter first.
LLM_PROVIDER_CHAIN=openrouter,unorouter

# Local Ollama (free narration; optional)
OLLAMA_BASE_URL=
LLM_DAILY_TOKEN_BUDGET=200000
# Per-call timeouts (seconds). Free OpenRouter models can queue 30-60s.
LLM_NARRATE_TIMEOUT_S=90
LLM_REASON_TIMEOUT_S=120

# Trading Settings
DEFAULT_RISK_PERCENT=0.5
MIN_RISK_REWARD=2.0
MAX_TOTAL_EXPOSURE_PCT=10.0
MAX_POSITION_SIZE_LOTS=10.0

# Risk Management
MAX_DAILY_LOSS_PCT=0.02
MAX_DRAWDOWN_PCT=0.10
MAX_CORRELATED_EXPOSURE_PCT=5.0
ACCOUNT_EQUITY=10000

# News
NEWS_FILTER_ENABLED=true

# Permission ceiling for the whole process (0 = research only; 4 = live)
MAX_PERMISSION_LEVEL=0
